<?xml version="1.0"?>
<!-- NO SE USA en nano_uav_world.sdf (el world incluye X3_UAV/6 con motores).
     Modelo cinemático de referencia del nano-UAV (65 g); su VelocityControl
     escucha /nano_uav/cmd_vel, no el tópico del bridge. -->
<sdf version="1.9">
  <model name="nano_uav">
    <pose>0 0 0.5 0 0 0</pose>

    <!-- Sin gravedad en el link: el VelocityControl controla posición directamente -->
    <enable_wind>false</enable_wind>

    <link name="body">
      <gravity>false</gravity>

      <inertial>
        <mass>0.065</mass>
        <inertia>
          <ixx>3.55e-5</ixx><iyy>4.23e-5</iyy><izz>7.47e-5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="body_col">
        <geometry><box><size>0.10 0.10 0.03</size></box></geometry>
      </collision>

      <visual name="body_vis">
        <geometry><box><size>0.10 0.10 0.025</size></box></geometry>
        <material>
          <ambient>0.15 0.35 0.75 1</ambient>
          <diffuse>0.15 0.35 0.75 1</diffuse>
          <specular>0.4 0.4 0.6 1</specular>
        </material>
      </visual>

      <visual name="arm_fl"><pose>0.035 0.035 0 0 0 0.785</pose>
        <geometry><box><size>0.10 0.007 0.004</size></box></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="arm_fr"><pose>0.035 -0.035 0 0 0 -0.785</pose>
        <geometry><box><size>0.10 0.007 0.004</size></box></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="arm_rl"><pose>-0.035 0.035 0 0 0 -0.785</pose>
        <geometry><box><size>0.10 0.007 0.004</size></box></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>
      <visual name="arm_rr"><pose>-0.035 -0.035 0 0 0 0.785</pose>
        <geometry><box><size>0.10 0.007 0.004</size></box></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
      </visual>

      <visual name="m_fl"><pose>0.055 0.055 0.006 0 0 0</pose>
        <geometry><cylinder><radius>0.011</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.85 0.15 0.1 1</ambient><diffuse>0.85 0.15 0.1 1</diffuse></material>
      </visual>
      <visual name="m_fr"><pose>0.055 -0.055 0.006 0 0 0</pose>
        <geometry><cylinder><radius>0.011</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="m_rl"><pose>-0.055 0.055 0.006 0 0 0</pose>
        <geometry><cylinder><radius>0.011</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
      </visual>
      <visual name="m_rr"><pose>-0.055 -0.055 0.006 0 0 0</pose>
        <geometry><cylinder><radius>0.011</radius><length>0.01</length></cylinder></geometry>
        <material><ambient>0.85 0.15 0.1 1</ambient><diffuse>0.85 0.15 0.1 1</diffuse></material>
      </visual>

      <visual name="p_fl"><pose>0.055 0.055 0.012 0 0 0</pose>
        <geometry><cylinder><radius>0.028</radius><length>0.001</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.6 0.4</ambient><diffuse>0.6 0.6 0.6 0.4</diffuse></material>
      </visual>
      <visual name="p_fr"><pose>0.055 -0.055 0.012 0 0 0</pose>
        <geometry><cylinder><radius>0.028</radius><length>0.001</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.6 0.4</ambient><diffuse>0.6 0.6 0.6 0.4</diffuse></material>
      </visual>
      <visual name="p_rl"><pose>-0.055 0.055 0.012 0 0 0</pose>
        <geometry><cylinder><radius>0.028</radius><length>0.001</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.6 0.4</ambient><diffuse>0.6 0.6 0.6 0.4</diffuse></material>
      </visual>
      <visual name="p_rr"><pose>-0.055 -0.055 0.012 0 0 0</pose>
        <geometry><cylinder><radius>0.028</radius><length>0.001</length></cylinder></geometry>
        <material><ambient>0.6 0.6 0.6 0.4</ambient><diffuse>0.6 0.6 0.6 0.4</diffuse></material>
      </visual>

      <sensor name="imu" type="imu">
        <always_on>1</always_on>
        <update_rate>200</update_rate>
        <topic>/nano_uav/imu</topic>
      </sensor>

      <sensor name="camera" type="camera">
        <pose>0.05 0 -0.005 0 0.15 0</pose>
        <always_on>1</always_on>
        <update_rate>10</update_rate>
        <topic>/nano_uav/camera</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>96</width><height>96</height><format>L8</format></image>
          <clip><near>0.05</near><far>8.0</far></clip>
        </camera>
      </sensor>

      <sensor name="depth_tof" type="depth_camera">
        <pose>0.05 0 -0.005 0 0.15 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <topic>/nano_uav/depth</topic>
        <camera>
          <horizontal_fov>0.698</horizontal_fov>
          <image><width>8</width><height>8</height></image>
          <clip><near>0.1</near><far>4.0</far></clip>
        </camera>
      </sensor>
    </link>

    <plugin
      filename="gz-sim-velocity-control-system"
      name="gz::sim::systems::VelocityControl">
      <topic>/nano_uav/cmd_vel</topic>
    </plugin>

  </model>
</sdf>
