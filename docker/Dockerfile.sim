FROM nano_uav_sim:fixed

# Copiar proyecto
COPY . /sim/nano_uav/

# Dependencias Python adicionales del proyecto
RUN pip3 install --break-system-packages pillow

# Variables de entorno
ENV GZ_SIM_RESOURCE_PATH=/sim/nano_uav/gazebo/models
ENV PYTHONPATH=/sim/nano_uav/src:$PYTHONPATH
ENV NANOUAV_HOME=/sim/nano_uav
ENV NANO_UAV_ROOT=/sim/nano_uav
ENV GZ_PARTITION=nano_uav_sim

WORKDIR /sim/nano_uav

CMD ["bash", "gazebo/run_sim.sh"]
